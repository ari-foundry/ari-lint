// Diagnostic data shapes and optional diagnostic carriers only. This file does
// not format output or serialize JSON.

pub enum OptionalPosition {
  Missing,
  Value(i64),
}

pub struct SourceSpan {
  file_path: Slice[u8],
  line: i64,
  column: i64,
  end_line: OptionalPosition,
  end_column: OptionalPosition,
}

pub struct Diagnostic {
  span: SourceSpan,
  severity: super::severity::Severity,
  message: Slice[u8],
  source: Slice[u8],
  code: Slice[u8],
}

pub enum OptionalDiagnostic {
  NoDiagnostic,
  SomeDiagnostic(Diagnostic),
}

pub fn source_span_with_end(
  file_path: Slice[u8],
  line: i64,
  column: i64,
  end_line: i64,
  end_column: i64
) -> SourceSpan {
  return SourceSpan {
    file_path: file_path,
    line: line,
    column: column,
    end_line: Value(end_line),
    end_column: Value(end_column),
  };
}

pub fn diagnostic_from_span(
  span: SourceSpan,
  severity: super::severity::Severity,
  code: Slice[u8],
  message: Slice[u8]
) -> Diagnostic {
  return diagnostic_from_span_with_source_code(
    span,
    severity,
    "ari-lint",
    code,
    message
  );
}

pub fn diagnostic_from_span_with_source_code(
  span: SourceSpan,
  severity: super::severity::Severity,
  source: Slice[u8],
  code: Slice[u8],
  message: Slice[u8]
) -> Diagnostic {
  return Diagnostic {
    span: span,
    severity: severity,
    message: message,
    source: source,
    code: code,
  };
}

pub fn compiler_diagnostic_from_span(
  span: SourceSpan,
  severity: super::severity::Severity,
  code: Slice[u8],
  message: Slice[u8]
) -> Diagnostic {
  return diagnostic_from_span_with_source_code(
    span,
    severity,
    "ari",
    code,
    message
  );
}

pub fn diagnostic_with_severity(
  diagnostic: Diagnostic,
  severity: super::severity::Severity
) -> Diagnostic {
  return diagnostic_from_span_with_source_code(
    diagnostic.span,
    severity,
    diagnostic.source,
    diagnostic.code,
    diagnostic.message
  );
}

pub fn no_diagnostic() -> OptionalDiagnostic {
  return NoDiagnostic;
}

pub fn some_diagnostic(diagnostic: Diagnostic) -> OptionalDiagnostic {
  return SomeDiagnostic(diagnostic);
}

pub fn first_available_diagnostic(
  current: OptionalDiagnostic,
  candidate: OptionalDiagnostic
) -> OptionalDiagnostic {
  match current {
    NoDiagnostic => {
      return candidate;
    }
    SomeDiagnostic(diagnostic) => {
      return SomeDiagnostic(diagnostic);
    }
  }
}
