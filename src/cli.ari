// CLI model, explicit-token parsing, semantic rule override parsing bridge,
// stdout-free dispatch, internal exit-code data, explicit-token list-rules
// command wiring, explicit-token entry point, OS argv integration, a
// main-facing output path, an internal source-file lint path, explicit config
// path capture, explicit compiler path capture, compiler check planning,
// parent-directory config discovery, explicit config override application, and
// an internal caller-provided diagnostic collection path.
// The positional source file input and documented options are represented here.
// This file reads process arguments only through the verified std::env::args
// boundary. Main now returns the internal command exit-code mapping through
// this path, while source-file dispatch reads all explicitly provided file
// paths through the source boundary, runs in-memory lint aggregation, carries
// the first internal diagnostic, reads an explicit --config path when one is
// provided, otherwise searches upward from the current working directory for
// ari-lint.rules, and applies parsed config and --rule severity overrides when
// provided. A separate collection path pushes full internal diagnostics into a
// caller-provided vector. The main-facing path writes human-readable or JSON
// list-rules text to stdout, source lint diagnostics to stderr, source-file JSON
// diagnostics to stdout, CLI help text to stdout, CLI parse problem summaries
// to stderr, and source/config file read errors to stderr through verified
// output adapters.
// Missing source-file input writes a short stderr summary. It does not read
// environment variables beyond the current working directory, home/global/XDG
// config locations, recursively scan source trees, call tools/lint, call
// process exit, or invoke ari --check.

pub struct CliOptionMetadata {
  name: Slice[u8],
  purpose: Slice[u8],
  takes_value: bool,
  multiple: bool,
}

pub struct CliSurfaceMetadata {
  positional_source_file_input: CliOptionMetadata,
  json: CliOptionMetadata,
  ari: CliOptionMetadata,
  include_path: CliOptionMetadata,
  list_rules: CliOptionMetadata,
  config: CliOptionMetadata,
  rule: CliOptionMetadata,
}

pub struct CliRuleOverrideArg {
  raw_text: Slice[u8],
}

pub enum CliArgumentProblemKind {
  MissingValue,
  UnknownArgument,
  InvalidRuleOverride,
}

pub struct CliArgumentProblem {
  kind: CliArgumentProblemKind,
  argument: Slice[u8],
  detail: Slice[u8],
}

pub struct CliArgs {
  source_count: i64,
  first_source_file: Slice[u8],
  source_files: std::vec::Vec[std::string::String],
  has_source_file: bool,
  json_requested: bool,
  list_rules_requested: bool,
  help_requested: bool,
  ari_compiler_path_present: bool,
  ari_compiler_path: Slice[u8],
  include_path_count: i64,
  first_include_path: Slice[u8],
  include_paths: std::vec::Vec[std::string::String],
  config_path_present: bool,
  config_file_path: Slice[u8],
  rule_override_count: i64,
  rule_override_problem_count: i64,
  first_rule_override_problem: Slice[u8],
}

pub struct CliCompilerCheckPlan {
  compiler_path_present: bool,
  compiler_path: Slice[u8],
  source_count: i64,
  first_source_file: Slice[u8],
  source_files: std::vec::Vec[std::string::String],
  include_path_count: i64,
  first_include_path: Slice[u8],
  include_paths: std::vec::Vec[std::string::String],
  check_argument: Slice[u8],
  invokes_compiler: bool,
  calls_tools_lint: bool,
}

pub struct CliCompilerCheckExecutionBoundary {
  compiler_path_present: bool,
  compiler_path: Slice[u8],
  planned_argument_count: i64,
  uses_planned_argv: bool,
  invokes_compiler: bool,
  captures_stdout: bool,
  captures_stderr: bool,
  calls_tools_lint: bool,
}

pub struct CliParseResult {
  args: CliArgs,
  problem_count: i64,
  missing_value_count: i64,
  first_missing_value_option: Slice[u8],
  unknown_argument_count: i64,
  first_unknown_argument: Slice[u8],
}

pub enum CliCommandResultKind {
  CliListRulesText,
  CliListRulesJson,
  CliParseProblems,
  CliHelpText,
  CliSourceLintResult,
  CliConfigReadError,
  CliMissingSource,
}

pub enum CliExitCodeKind {
  CliExitSuccess,
  CliExitUsageError,
  CliExitUnavailable,
}

pub struct CliExitCodeMapping {
  kind: CliExitCodeKind,
  code: i64,
  calls_process_exit: bool,
  detail: Slice[u8],
}

pub struct CliCommandResult {
  kind: CliCommandResultKind,
  text_available: bool,
  diagnostic_count: i64,
  mut first_diagnostic: super::diagnostic::OptionalDiagnostic,
  read_error_count: i64,
  exit_code: CliExitCodeMapping,
  detail: Slice[u8],
}

pub struct OsArgvBoundary {
  status: Slice[u8],
  reads_process_argv: bool,
  reads_environment: bool,
  writes_output: bool,
  dispatches_tokens: bool,
}

pub fn os_argv_boundary(zone: ref mut Zone) -> OsArgvBoundary {
  return OsArgvBoundary {
    status: "OS argv integration boundary reads process arguments through std::env::args.",
    reads_process_argv: true,
    reads_environment: false,
    writes_output: false,
    dispatches_tokens: true,
  };
}

fn missing_value_problem(argument: Slice[u8]) -> CliArgumentProblem {
  return CliArgumentProblem {
    kind: MissingValue,
    argument: argument,
    detail: "missing option value",
  };
}

fn unknown_argument_problem(argument: Slice[u8]) -> CliArgumentProblem {
  return CliArgumentProblem {
    kind: UnknownArgument,
    argument: argument,
    detail: "unknown argument",
  };
}

fn raw_rule_override(raw_text: Slice[u8]) -> CliRuleOverrideArg {
  return CliRuleOverrideArg {
    raw_text: raw_text,
  };
}

fn cli_exit_code_mapping(
  kind: CliExitCodeKind,
  code: i64,
  detail: Slice[u8]
) -> CliExitCodeMapping {
  return CliExitCodeMapping {
    kind: kind,
    code: code,
    calls_process_exit: false,
    detail: detail,
  };
}

fn cli_success_exit_code(zone: ref mut Zone) -> CliExitCodeMapping {
  return cli_exit_code_mapping(
    CliExitSuccess,
    0,
    "Command result maps to success internally; process exit remains future work."
  );
}

fn cli_usage_error_exit_code(zone: ref mut Zone) -> CliExitCodeMapping {
  return cli_exit_code_mapping(
    CliExitUsageError,
    2,
    "Command result maps to a usage error internally; process exit remains future work."
  );
}

fn cli_unavailable_exit_code(zone: ref mut Zone) -> CliExitCodeMapping {
  return cli_exit_code_mapping(
    CliExitUnavailable,
    1,
    "Command result maps to unavailable behavior internally; process exit remains future work."
  );
}

fn cli_command_result(
  kind: CliCommandResultKind,
  text_available: bool,
  diagnostic_count: i64,
  read_error_count: i64,
  exit_code: CliExitCodeMapping,
  detail: Slice[u8]
) -> CliCommandResult {
  return CliCommandResult {
    kind: kind,
    text_available: text_available,
    diagnostic_count: diagnostic_count,
    first_diagnostic: super::diagnostic::no_diagnostic(),
    read_error_count: read_error_count,
    exit_code: exit_code,
    detail: detail,
  };
}

fn cli_file_lint_exit_code(
  zone: ref mut Zone,
  diagnostic_count: i64,
  read_error_count: i64
) -> CliExitCodeMapping {
  if read_error_count > 0 {
    return cli_unavailable_exit_code(zone);
  }
  if diagnostic_count > 0 {
    return cli_usage_error_exit_code(zone);
  }
  return cli_success_exit_code(zone);
}

pub fn parse_cli_tokens(
  zone: ref mut Zone,
  tokens: ref std::vec::Vec[std::string::String]
) -> CliParseResult {
  let token_allocator = std::allocator::of(tokens);
  var source_count = 0;
  var first_source_file: Slice[u8] = "";
  var source_files = std::vec::new_with_allocator<std::string::String>(
    ref token_allocator,
    tokens.len()
  );
  var has_source_file = false;
  var json_requested = false;
  var list_rules_requested = false;
  var help_requested = false;
  var ari_compiler_path_present = false;
  var ari_compiler_path: Slice[u8] = "";
  var include_path_count = 0;
  var first_include_path: Slice[u8] = "";
  var include_paths = std::vec::new_with_allocator<std::string::String>(
    ref token_allocator,
    tokens.len()
  );
  var config_path_present = false;
  var config_file_path: Slice[u8] = "";
  var rule_override_count = 0;
  var rule_override_problem_count = 0;
  var first_rule_override_problem: Slice[u8] = "";
  var problem_count = 0;
  var missing_value_count = 0;
  var first_missing_value_option: Slice[u8] = "";
  var unknown_argument_count = 0;
  var first_unknown_argument: Slice[u8] = "";

  var index = 0;
  while index < tokens.len() {
    let token = tokens.get(index);
    let token_text = token.as_slice();

    if token.equals("--json") {
      json_requested = true;
      index = index + 1;
    } else if token.equals("--list-rules") {
      list_rules_requested = true;
      index = index + 1;
    } else if token.equals("--help") || token.equals("-h") {
      help_requested = true;
      index = index + 1;
    } else if token.equals("--") {
      index = index + 1;
      while index < tokens.len() {
        let source_token_text = tokens.get(index).as_slice();
        if !has_source_file {
          first_source_file = source_token_text;
          has_source_file = true;
        }
        source_files.push(std::string::copy_with_allocator(
          ref token_allocator,
          source_token_text
        ));
        source_count = source_count + 1;
        index = index + 1;
      }
    } else if token.starts_with("--config=") {
      config_path_present = true;
      config_file_path = std::string::substring(
        token_text,
        9,
        token_text.len()
      );
      index = index + 1;
    } else if token.starts_with("--rule=") {
      let inline_rule_override = raw_rule_override(std::string::substring(
        token_text,
        7,
        token_text.len()
      ));
      let inline_rule_override_result = super::config::parse_rule_override_text(
        zone,
        inline_rule_override.raw_text
      );
      if inline_rule_override_result.problem_count > 0 && rule_override_problem_count == 0 {
        first_rule_override_problem = inline_rule_override.raw_text;
      }
      rule_override_count = rule_override_count + inline_rule_override_result.override_count;
      rule_override_problem_count =
        rule_override_problem_count + inline_rule_override_result.problem_count;
      index = index + 1;
    } else if token.starts_with("--ari=") {
      ari_compiler_path_present = true;
      ari_compiler_path = std::string::substring(
        token_text,
        6,
        token_text.len()
      );
      index = index + 1;
    } else if token.equals("--ari") {
      if index + 1 < tokens.len() {
        ari_compiler_path_present = true;
        ari_compiler_path = tokens.get(index + 1).as_slice();
        index = index + 2;
      } else {
        if missing_value_count == 0 {
          first_missing_value_option = token_text;
        }
        missing_value_count = missing_value_count + 1;
        problem_count = problem_count + 1;
        index = index + 1;
      }
    } else if token.equals("-I") {
      if index + 1 < tokens.len() {
        let include_path_text = tokens.get(index + 1).as_slice();
        if include_path_count == 0 {
          first_include_path = include_path_text;
        }
        include_paths.push(std::string::copy_with_allocator(
          ref token_allocator,
          include_path_text
        ));
        include_path_count = include_path_count + 1;
        index = index + 2;
      } else {
        if missing_value_count == 0 {
          first_missing_value_option = token_text;
        }
        missing_value_count = missing_value_count + 1;
        problem_count = problem_count + 1;
        index = index + 1;
      }
    } else if token.equals("--config") {
      if index + 1 < tokens.len() {
        config_path_present = true;
        config_file_path = tokens.get(index + 1).as_slice();
        index = index + 2;
      } else {
        if missing_value_count == 0 {
          first_missing_value_option = token_text;
        }
        missing_value_count = missing_value_count + 1;
        problem_count = problem_count + 1;
        index = index + 1;
      }
    } else if token.equals("--rule") {
      if index + 1 < tokens.len() {
        let rule_override = raw_rule_override(tokens.get(index + 1).as_slice());
        let rule_override_result = super::config::parse_rule_override_text(
          zone,
          rule_override.raw_text
        );
        if rule_override_result.problem_count > 0 && rule_override_problem_count == 0 {
          first_rule_override_problem = rule_override.raw_text;
        }
        rule_override_count = rule_override_count + rule_override_result.override_count;
        rule_override_problem_count =
          rule_override_problem_count + rule_override_result.problem_count;
        index = index + 2;
      } else {
        if missing_value_count == 0 {
          first_missing_value_option = token_text;
        }
        missing_value_count = missing_value_count + 1;
        problem_count = problem_count + 1;
        index = index + 1;
      }
    } else if token.starts_with("-") {
      if unknown_argument_count == 0 {
        first_unknown_argument = token_text;
      }
      unknown_argument_count = unknown_argument_count + 1;
      problem_count = problem_count + 1;
      index = index + 1;
    } else {
      if !has_source_file {
        first_source_file = token_text;
        has_source_file = true;
      }
      source_files.push(std::string::copy_with_allocator(
        ref token_allocator,
        token_text
      ));
      source_count = source_count + 1;
      index = index + 1;
    }
  }

  let args = CliArgs {
    source_count: source_count,
    first_source_file: first_source_file,
    source_files: source_files,
    has_source_file: has_source_file,
    json_requested: json_requested,
    list_rules_requested: list_rules_requested,
    help_requested: help_requested,
    ari_compiler_path_present: ari_compiler_path_present,
    ari_compiler_path: ari_compiler_path,
    include_path_count: include_path_count,
    first_include_path: first_include_path,
    include_paths: include_paths,
    config_path_present: config_path_present,
    config_file_path: config_file_path,
    rule_override_count: rule_override_count,
    rule_override_problem_count: rule_override_problem_count,
    first_rule_override_problem: first_rule_override_problem,
  };

  return CliParseResult {
    args: args,
    problem_count: problem_count,
    missing_value_count: missing_value_count,
    first_missing_value_option: first_missing_value_option,
    unknown_argument_count: unknown_argument_count,
    first_unknown_argument: first_unknown_argument,
  };
}

pub fn parse_cli_rule_overrides(
  zone: ref mut Zone,
  rule_override: CliRuleOverrideArg
) -> super::config::RuleOverrideParseResult {
  return super::config::parse_rule_override_text(zone, rule_override.raw_text);
}

pub fn compiler_check_plan_from_cli_args(
  zone: ref mut Zone,
  args: CliArgs
) -> CliCompilerCheckPlan {
  return CliCompilerCheckPlan {
    compiler_path_present: args.ari_compiler_path_present,
    compiler_path: args.ari_compiler_path,
    source_count: args.source_count,
    first_source_file: args.first_source_file,
    source_files: args.source_files,
    include_path_count: args.include_path_count,
    first_include_path: args.first_include_path,
    include_paths: args.include_paths,
    check_argument: "--check",
    invokes_compiler: false,
    calls_tools_lint: false,
  };
}

pub fn plan_explicit_cli_compiler_check(
  zone: ref mut Zone,
  tokens: std::vec::Vec[std::string::String]
) -> CliCompilerCheckPlan {
  let parse_result = parse_cli_tokens(zone, ref tokens);
  return compiler_check_plan_from_cli_args(zone, parse_result.args);
}

pub fn compiler_check_argv_from_plan(
  zone: ref mut Zone,
  plan: CliCompilerCheckPlan
) -> std::vec::Vec[std::string::String] {
  var argv = std::vec::new<std::string::String>(
    zone,
    1 + (plan.include_path_count * 2) + plan.source_count
  );
  argv.push(std::string::from_slice_in(zone, plan.check_argument));

  for include_path in plan.include_paths {
    argv.push(std::string::from(zone, "-I"));
    argv.push(std::string::from_slice_in(zone, include_path.as_slice()));
  }

  for source_file in plan.source_files {
    argv.push(std::string::from_slice_in(zone, source_file.as_slice()));
  }

  return argv;
}

pub fn plan_explicit_cli_compiler_check_argv(
  zone: ref mut Zone,
  tokens: std::vec::Vec[std::string::String]
) -> std::vec::Vec[std::string::String] {
  let plan = plan_explicit_cli_compiler_check(zone, tokens);
  return compiler_check_argv_from_plan(zone, plan);
}

pub fn compiler_check_execution_boundary_from_plan(
  zone: ref mut Zone,
  plan: CliCompilerCheckPlan
) -> CliCompilerCheckExecutionBoundary {
  return CliCompilerCheckExecutionBoundary {
    compiler_path_present: plan.compiler_path_present,
    compiler_path: plan.compiler_path,
    planned_argument_count: 1 + (plan.include_path_count * 2) + plan.source_count,
    uses_planned_argv: true,
    invokes_compiler: false,
    captures_stdout: false,
    captures_stderr: false,
    calls_tools_lint: false,
  };
}

pub fn plan_explicit_cli_compiler_check_execution_boundary(
  zone: ref mut Zone,
  tokens: std::vec::Vec[std::string::String]
) -> CliCompilerCheckExecutionBoundary {
  let plan = plan_explicit_cli_compiler_check(zone, tokens);
  return compiler_check_execution_boundary_from_plan(zone, plan);
}

pub fn dispatch_cli_command(
  zone: ref mut Zone,
  parse_result: CliParseResult
) -> CliCommandResult {
  if parse_result.problem_count > 0 || parse_result.args.rule_override_problem_count > 0 {
    return cli_command_result(
      CliParseProblems,
      false,
      0,
      0,
      cli_usage_error_exit_code(zone),
      "CLI parse problems are recorded internally; diagnostic output remains future work."
    );
  }

  if parse_result.args.list_rules_requested {
    let list_rules = super::output::known_list_rules_output(zone);
    if parse_result.args.json_requested {
      let json_text = super::output::format_list_rules_json(zone, list_rules);
      return cli_command_result(
        CliListRulesJson,
        json_text.len() >= 0,
        0,
        0,
        cli_success_exit_code(zone),
        "List-rules JSON text is available internally; stdout/stderr output remains future work."
      );
    }
    let human_text = super::output::format_list_rules_human(zone, list_rules);
    return cli_command_result(
      CliListRulesText,
      human_text.len() >= 0,
      0,
      0,
      cli_success_exit_code(zone),
      "List-rules text is available internally; stdout/stderr output remains future work."
    );
  }

  if parse_result.args.help_requested {
    return cli_command_result(
      CliHelpText,
      false,
      0,
      0,
      cli_success_exit_code(zone),
      "Help command dispatch is recognized internally without writing output."
    );
  }

  if parse_result.args.has_source_file {
    var diagnostic_count = 0;
    var read_error_count = 0;
    var first_diagnostic = super::diagnostic::no_diagnostic();
    for source_file in parse_result.args.source_files {
      let lint_result = super::lint::lint_file_source(
        zone,
        source_file.as_slice()
      );
      diagnostic_count = diagnostic_count + lint_result.diagnostic_count;
      read_error_count = read_error_count + lint_result.read_error_count;
      first_diagnostic = super::diagnostic::first_available_diagnostic(
        first_diagnostic,
        lint_result.first_diagnostic
      );
    }
    let exit_code = cli_file_lint_exit_code(
      zone,
      diagnostic_count,
      read_error_count
    );
    var command_result = cli_command_result(
      CliSourceLintResult,
      false,
      diagnostic_count,
      read_error_count,
      exit_code,
      "Source-file lint diagnostics are available internally without writing output."
    );
    command_result.first_diagnostic = first_diagnostic;
    return command_result;
  }

  return cli_command_result(
    CliMissingSource,
    false,
    0,
    0,
    cli_usage_error_exit_code(zone),
    "CLI source-file input is required; stdout-free dispatch does not write output."
  );
}

fn write_diagnostics_stderr(
  zone: ref mut Zone,
  diagnostics: std::vec::Vec[super::diagnostic::Diagnostic]
) -> bool {
  if diagnostics.len() == 0 {
    return true;
  }
  let text = super::output::format_diagnostics_human(zone, diagnostics);
  let write_result = super::output::write_stderr_text(zone, ref text);
  return write_result.wrote_stderr;
}

fn write_diagnostics_json_stdout(
  zone: ref mut Zone,
  diagnostics: std::vec::Vec[super::diagnostic::Diagnostic]
) -> bool {
  let text = super::output::serialize_diagnostics_json(zone, diagnostics);
  let write_result = super::output::write_stdout_text(zone, ref text);
  return write_result.wrote_stdout;
}

fn write_cli_parse_problem_stderr(
  zone: ref mut Zone,
  rule_override_problem_count: i64,
  first_rule_override_problem: Slice[u8],
  missing_value_count: i64,
  first_missing_value_option: Slice[u8],
  unknown_argument_count: i64,
  first_unknown_argument: Slice[u8]
) -> bool {
  var text = std::string::from(zone, "ari-lint: invalid command-line arguments\n");
  if rule_override_problem_count > 0 {
    text = std::string::from(zone, "ari-lint: invalid --rule override");
    if first_rule_override_problem.len() > 0 {
      text.append_string_in(zone, ": ");
      text.append_string_in(zone, first_rule_override_problem);
    }
    text.append_string_in(zone, "; expected --rule RULE=SEVERITY\n");
  } else if missing_value_count > 0 {
    text = std::string::from(zone, "ari-lint: missing option value for ");
    text.append_string_in(zone, first_missing_value_option);
    text.append_string_in(zone, "\n");
  } else if unknown_argument_count > 0 {
    text = std::string::from(zone, "ari-lint: unknown argument: ");
    text.append_string_in(zone, first_unknown_argument);
    text.append_string_in(zone, "\n");
  }
  let write_result = super::output::write_stderr_text(zone, ref text);
  return write_result.wrote_stderr;
}

fn write_cli_parse_detail_stderr(zone: ref mut Zone, detail: Slice[u8]) -> bool {
  var text = std::string::from_slice_in(zone, detail);
  let write_result = super::output::write_stderr_text(zone, ref text);
  return write_result.wrote_stderr;
}

fn write_cli_help_stdout(zone: ref mut Zone) -> bool {
  var text = std::string::new(zone, 384);
  text.append_string_in(zone, "Usage: ari-lint [options] <source-file>...\n");
  text.append_string_in(zone, "\n");
  text.append_string_in(zone, "Options:\n");
  text.append_string_in(zone, "  -h, --help                 Show this help text.\n");
  text.append_string_in(zone, "  --list-rules               List known lint rules.\n");
  text.append_string_in(zone, "  --json                     Write source-file diagnostics as JSON.\n");
  text.append_string_in(zone, "  --config PATH              Load rule severities from a config file.\n");
  text.append_string_in(zone, "  --rule RULE=SEVERITY       Override a known rule severity.\n");
  text.append_string_in(zone, "  --                          Treat following arguments as source files.\n");
  let write_result = super::output::write_stdout_text(zone, ref text);
  return write_result.wrote_stdout;
}

fn write_missing_source_stderr(zone: ref mut Zone) -> bool {
  let text = std::string::from(zone, "ari-lint: missing source file\n");
  let write_result = super::output::write_stderr_text(zone, ref text);
  return write_result.wrote_stderr;
}

fn write_file_read_error_stderr(
  zone: ref mut Zone,
  source_count: i64,
  path: Slice[u8]
) -> bool {
  var text = std::string::new(zone, 128);
  if source_count <= 1 {
    text.append_string_in(zone, "ari-lint: unable to read source file: ");
    text.append_string_in(zone, path);
  } else {
    text.append_string_in(zone, "ari-lint: unable to read one or more source files");
    if path.len() > 0 {
      text.append_string_in(zone, ": ");
      text.append_string_in(zone, path);
    }
  }
  text.append_string_in(zone, "\n");
  let write_result = super::output::write_stderr_text(zone, ref text);
  return write_result.wrote_stderr;
}

fn write_config_read_error_stderr(zone: ref mut Zone, path: Slice[u8]) -> bool {
  var text = std::string::new(zone, 128);
  text.append_string_in(zone, "ari-lint: unable to read config file: ");
  text.append_string_in(zone, path);
  text.append_string_in(zone, "\n");
  let write_result = super::output::write_stderr_text(zone, ref text);
  return write_result.wrote_stderr;
}

fn format_config_parse_problem_stderr(
  zone: ref mut Zone,
  path: Slice[u8],
  result: super::config::ConfigFileParseResult
) -> std::string::String {
  var text = std::string::new(zone, 192);
  text.append_string_in(zone, "ari-lint: invalid config file: ");
  text.append_string_in(zone, path);
  if result.first_problem_line > 0 {
    text.append_string_in(zone, ":");
    text.append_i64_in(zone, result.first_problem_line);
  }
  if result.first_problem_text.len() > 0 {
    text.append_string_in(zone, ": ");
    text.append_string_in(zone, result.first_problem_text);
  }
  if result.first_problem_detail.len() > 0 {
    text.append_string_in(zone, "; ");
    text.append_string_in(zone, result.first_problem_detail);
  }
  text.append_string_in(zone, "\n");
  return text;
}

fn discovered_config_file_name() -> Slice[u8] {
  return "ari-lint.rules";
}

fn discovered_config_file_path(zone: ref mut Zone) -> std::string::String {
  var directory = std::env::current_dir_or_default(zone);
  if directory.len() == 0 {
    return std::string::new(zone, 0);
  }

  while true {
    let candidate = std::path::join_in(
      zone,
      directory.as_slice(),
      discovered_config_file_name()
    );
    if std::fs::exists(candidate.as_slice()) {
      return candidate;
    }

    match std::path::parent(directory.as_slice()) {
      std::Some(parent) => {
        directory = std::string::from_slice_in(zone, parent);
      }
      std::None => {
        break;
      }
    }
  }

  return std::string::new(zone, 0);
}

fn selected_config_file_path(
  zone: ref mut Zone,
  parse_result: CliParseResult
) -> std::string::String {
  if parse_result.args.config_path_present {
    return std::string::from_slice_in(zone, parse_result.args.config_file_path);
  }
  return discovered_config_file_path(zone);
}

fn dispatch_cli_command_with_main_output(
  zone: ref mut Zone,
  tokens: ref std::vec::Vec[std::string::String],
  parse_result: CliParseResult
) -> CliCommandResult {
  if parse_result.problem_count > 0 || parse_result.args.rule_override_problem_count > 0 {
    let wrote_parse_stderr = write_cli_parse_problem_stderr(
      zone,
      parse_result.args.rule_override_problem_count,
      parse_result.args.first_rule_override_problem,
      parse_result.missing_value_count,
      parse_result.first_missing_value_option,
      parse_result.unknown_argument_count,
      parse_result.first_unknown_argument
    );
    if !wrote_parse_stderr {
      return cli_command_result(
        CliParseProblems,
        false,
        0,
        0,
        cli_unavailable_exit_code(zone),
        "CLI parse problem stderr write failed through the verified stderr adapter."
      );
    }
    return cli_command_result(
      CliParseProblems,
      false,
      0,
      0,
      cli_usage_error_exit_code(zone),
      "CLI parse problem summary was written to stderr through the verified stderr adapter."
    );
  }

  if parse_result.args.help_requested {
    let wrote_help_stdout = write_cli_help_stdout(zone);
    if !wrote_help_stdout {
      return cli_command_result(
        CliHelpText,
        true,
        0,
        0,
        cli_unavailable_exit_code(zone),
        "CLI help stdout write failed through the verified stdout adapter."
      );
    }
    return cli_command_result(
      CliHelpText,
      true,
      0,
      0,
      cli_success_exit_code(zone),
      "CLI help text was written to stdout through the verified stdout adapter."
    );
  }

  if parse_result.args.list_rules_requested {
    let list_rules = super::output::known_list_rules_output(zone);
    if parse_result.args.json_requested {
      let json_text = super::output::format_list_rules_json(zone, list_rules);
      let json_write_result = super::output::write_stdout_text(zone, ref json_text);
      if !json_write_result.wrote_stdout {
        return cli_command_result(
          CliListRulesJson,
          true,
          0,
          0,
          cli_unavailable_exit_code(zone),
          "List-rules JSON stdout write failed through the verified stdout adapter."
        );
      }
      return cli_command_result(
        CliListRulesJson,
        true,
        0,
        0,
        cli_success_exit_code(zone),
        "List-rules JSON text was written to stdout through the verified stdout adapter."
      );
    }
    let human_text = super::output::format_list_rules_human(zone, list_rules);
    let write_result = super::output::write_stdout_text(zone, ref human_text);
    if !write_result.wrote_stdout {
      return cli_command_result(
        CliListRulesText,
        true,
        0,
        0,
        cli_unavailable_exit_code(zone),
        "List-rules stdout write failed through the verified stdout adapter."
      );
    }
    return cli_command_result(
      CliListRulesText,
      true,
      0,
      0,
      cli_success_exit_code(zone),
      "List-rules text was written to stdout through the verified stdout adapter."
    );
  }

  if parse_result.args.has_source_file {
    var diagnostics = std::vec::new<super::diagnostic::Diagnostic>(zone, 8);
    var command_result = collect_cli_source_diagnostics_from_tokens(
      zone,
      tokens,
      parse_result,
      ref mut diagnostics
    );
    match command_result.kind {
      CliParseProblems => {
        var wrote_collection_parse_stderr = false;
        if command_result.text_available {
          wrote_collection_parse_stderr = write_cli_parse_detail_stderr(
            zone,
            command_result.detail
          );
        } else {
          wrote_collection_parse_stderr = write_cli_parse_problem_stderr(
            zone,
            parse_result.args.rule_override_problem_count,
            parse_result.args.first_rule_override_problem,
            parse_result.missing_value_count,
            parse_result.first_missing_value_option,
            parse_result.unknown_argument_count,
            parse_result.first_unknown_argument
          );
        }
        if !wrote_collection_parse_stderr {
          return cli_command_result(
            CliParseProblems,
            false,
            0,
            0,
            cli_unavailable_exit_code(zone),
            "CLI parse problem stderr write failed through the verified stderr adapter."
          );
        }
        return command_result;
      }
      CliConfigReadError => {
        let selected_config_path = selected_config_file_path(zone, parse_result);
        let wrote_config_read_error_stderr = write_config_read_error_stderr(
          zone,
          selected_config_path.as_slice()
        );
        if !wrote_config_read_error_stderr {
          return cli_command_result(
            CliConfigReadError,
            false,
            command_result.diagnostic_count,
            command_result.read_error_count,
            cli_unavailable_exit_code(zone),
            "Explicit config file read error stderr write failed through the verified stderr adapter."
          );
        }
        return command_result;
      }
      CliListRulesText => {}
      CliListRulesJson => {}
      CliHelpText => {}
      CliSourceLintResult => {}
      CliMissingSource => {}
    }
    if command_result.read_error_count > 0 {
      var read_error_path = command_result.detail;
      if read_error_path.len() == 0 {
        read_error_path = parse_result.args.first_source_file;
      }
      let wrote_read_error_stderr = write_file_read_error_stderr(
        zone,
        parse_result.args.source_count,
        read_error_path
      );
      if !wrote_read_error_stderr {
        var failed_read_result = cli_command_result(
          CliSourceLintResult,
          false,
          command_result.diagnostic_count,
          command_result.read_error_count,
          cli_unavailable_exit_code(zone),
          "Source-file read error stderr write failed through the verified stderr adapter."
        );
        failed_read_result.first_diagnostic = command_result.first_diagnostic;
        return failed_read_result;
      }
      return command_result;
    }
    if parse_result.args.json_requested {
      let wrote_stdout = write_diagnostics_json_stdout(
        zone,
        diagnostics
      );
      if !wrote_stdout {
        var failed_json_result = cli_command_result(
          CliSourceLintResult,
          false,
          command_result.diagnostic_count,
          command_result.read_error_count,
          cli_unavailable_exit_code(zone),
          "Source-file diagnostics JSON stdout write failed through the verified stdout adapter."
        );
        failed_json_result.first_diagnostic = command_result.first_diagnostic;
        return failed_json_result;
      }
    } else if command_result.diagnostic_count > 0 {
      let wrote_stderr = write_diagnostics_stderr(
        zone,
        diagnostics
      );
      if !wrote_stderr {
        var failed_result = cli_command_result(
          CliSourceLintResult,
          false,
          command_result.diagnostic_count,
          command_result.read_error_count,
          cli_unavailable_exit_code(zone),
          "Source-file diagnostics stderr write failed through the verified stderr adapter."
        );
        failed_result.first_diagnostic = command_result.first_diagnostic;
        return failed_result;
      }
    }
    return command_result;
  }

  let wrote_missing_source_stderr = write_missing_source_stderr(zone);
  if !wrote_missing_source_stderr {
    return cli_command_result(
      CliMissingSource,
      false,
      0,
      0,
      cli_unavailable_exit_code(zone),
      "Missing source-file stderr write failed through the verified stderr adapter."
    );
  }
  return cli_command_result(
    CliMissingSource,
    false,
    0,
    0,
    cli_usage_error_exit_code(zone),
    "Missing source-file summary was written to stderr through the verified stderr adapter."
  );
}

pub fn run_explicit_cli_tokens(
  zone: ref mut Zone,
  tokens: std::vec::Vec[std::string::String]
) -> CliCommandResult {
  let parse_result = parse_cli_tokens(zone, ref tokens);
  return dispatch_cli_command(zone, parse_result);
}

pub fn collect_explicit_cli_diagnostics(
  zone: ref mut Zone,
  tokens: std::vec::Vec[std::string::String],
  diagnostics: ref mut std::vec::Vec[super::diagnostic::Diagnostic]
) -> CliCommandResult {
  let parse_result = parse_cli_tokens(zone, ref tokens);
  return collect_cli_source_diagnostics_from_tokens(
    zone,
    ref tokens,
    parse_result,
    diagnostics
  );
}

fn collect_cli_rule_overrides_from_tokens(
  zone: ref mut Zone,
  tokens: ref std::vec::Vec[std::string::String],
  overrides: ref mut std::vec::Vec[super::config::RuleSeverityOverride]
) -> super::config::RuleOverrideParseResult {
  var override_count = 0;
  var problem_count = 0;
  var index = 0;
  while index < tokens.len() {
    let token = tokens.get(index);
    if token.equals("--") {
      break;
    } else if token.equals("--rule") && index + 1 < tokens.len() {
      let rule_override_result = super::config::parse_rule_override_text_into(
        zone,
        tokens.get(index + 1).as_slice(),
        overrides
      );
      override_count = override_count + rule_override_result.override_count;
      problem_count = problem_count + rule_override_result.problem_count;
      index = index + 2;
    } else if token.starts_with("--rule=") {
      let inline_collect_rule_override_result = super::config::parse_rule_override_text_into(
        zone,
        std::string::substring(token.as_slice(), 7, token.as_slice().len()),
        overrides
      );
      override_count = override_count + inline_collect_rule_override_result.override_count;
      problem_count = problem_count + inline_collect_rule_override_result.problem_count;
      index = index + 1;
    } else {
      index = index + 1;
    }
  }
  return super::config::RuleOverrideParseResult {
    override_count: override_count,
    problem_count: problem_count,
  };
}

fn collect_cli_source_diagnostics_from_tokens(
  zone: ref mut Zone,
  tokens: ref std::vec::Vec[std::string::String],
  parse_result: CliParseResult,
  diagnostics: ref mut std::vec::Vec[super::diagnostic::Diagnostic]
) -> CliCommandResult {
  if parse_result.problem_count > 0 || parse_result.args.rule_override_problem_count > 0 {
    return dispatch_cli_command(zone, parse_result);
  }

  var discovered_config_path = std::string::new(zone, 0);
  if parse_result.args.has_source_file && !parse_result.args.config_path_present {
    discovered_config_path = discovered_config_file_path(zone);
  }
  let discovered_config_present = discovered_config_path.len() > 0;

  if parse_result.args.has_source_file &&
    (
      parse_result.args.config_path_present ||
      discovered_config_present ||
      parse_result.args.rule_override_count > 0
    ) {
    var rule_overrides = std::vec::new<super::config::RuleSeverityOverride>(
      zone,
      parse_result.args.rule_override_count + 4
    );
    if parse_result.args.config_path_present {
      let config_parse_result = super::config::parse_explicit_config_file_into(
        zone,
        parse_result.args.config_file_path,
        ref mut rule_overrides
      );
      if config_parse_result.read_error_count > 0 {
        return cli_command_result(
          CliConfigReadError,
          false,
          0,
          config_parse_result.read_error_count,
          cli_unavailable_exit_code(zone),
          "Explicit config file read errors are recorded before source diagnostics are collected."
        );
      }
      if config_parse_result.problem_count > 0 {
        let config_problem_text = format_config_parse_problem_stderr(
          zone,
          parse_result.args.config_file_path,
          config_parse_result
        );
        return cli_command_result(
          CliParseProblems,
          true,
          0,
          0,
          cli_usage_error_exit_code(zone),
          config_problem_text.as_slice()
        );
      }
    } else if discovered_config_present {
      let discovered_config_parse_result = super::config::parse_discovered_config_file_into(
        zone,
        discovered_config_path.as_slice(),
        ref mut rule_overrides
      );
      if discovered_config_parse_result.read_error_count > 0 {
        return cli_command_result(
          CliConfigReadError,
          false,
          0,
          discovered_config_parse_result.read_error_count,
          cli_unavailable_exit_code(zone),
          "Discovered config file read errors are recorded before source diagnostics are collected."
        );
      }
      if discovered_config_parse_result.problem_count > 0 {
        let discovered_config_problem_text = format_config_parse_problem_stderr(
          zone,
          discovered_config_path.as_slice(),
          discovered_config_parse_result
        );
        return cli_command_result(
          CliParseProblems,
          true,
          0,
          0,
          cli_usage_error_exit_code(zone),
          discovered_config_problem_text.as_slice()
        );
      }
    }
    if parse_result.args.rule_override_count > 0 {
      let rule_override_result = collect_cli_rule_overrides_from_tokens(
        zone,
        tokens,
        ref mut rule_overrides
      );
      if rule_override_result.problem_count > 0 {
        return cli_command_result(
          CliParseProblems,
          false,
          0,
          0,
          cli_usage_error_exit_code(zone),
          "CLI rule override problems are recorded internally before source diagnostics are collected."
        );
      }
    }
    var diagnostic_count = 0;
    var read_error_count = 0;
    var first_read_error_path = std::string::new(zone, 0);
    for source_file in parse_result.args.source_files {
      let collection_result = super::lint::collect_file_lint_diagnostics_with_override_refs(
        zone,
        source_file.as_slice(),
        ref rule_overrides,
        diagnostics
      );
      diagnostic_count = diagnostic_count + collection_result.diagnostic_count;
      if collection_result.read_error_count > 0 && first_read_error_path.len() == 0 {
        first_read_error_path = std::string::from_slice_in(
          zone,
          source_file.as_slice()
        );
      }
      read_error_count = read_error_count + collection_result.read_error_count;
    }
    let exit_code = cli_file_lint_exit_code(zone, diagnostic_count, read_error_count);
    var result_detail: Slice[u8] =
      "Source-file lint diagnostics were collected with parsed config and --rule severity overrides without writing output.";
    if read_error_count > 0 {
      result_detail = first_read_error_path.as_slice();
    }
    var command_result = cli_command_result(
      CliSourceLintResult,
      false,
      diagnostic_count,
      read_error_count,
      exit_code,
      result_detail
    );
    if diagnostics.len() > 0 {
      command_result.first_diagnostic =
        super::diagnostic::some_diagnostic(diagnostics.get(0));
    }
    return command_result;
  }

  return collect_cli_source_diagnostics(zone, parse_result, diagnostics);
}

pub fn collect_cli_source_diagnostics(
  zone: ref mut Zone,
  parse_result: CliParseResult,
  diagnostics: ref mut std::vec::Vec[super::diagnostic::Diagnostic]
) -> CliCommandResult {
  if parse_result.problem_count > 0 || parse_result.args.rule_override_problem_count > 0 {
    return dispatch_cli_command(zone, parse_result);
  }

  if parse_result.args.has_source_file {
    var diagnostic_count = 0;
    var read_error_count = 0;
    var first_read_error_path = std::string::new(zone, 0);
    for source_file in parse_result.args.source_files {
      let collection_result = super::lint::collect_file_lint_diagnostics(
        zone,
        source_file.as_slice(),
        diagnostics
      );
      diagnostic_count = diagnostic_count + collection_result.diagnostic_count;
      if collection_result.read_error_count > 0 && first_read_error_path.len() == 0 {
        first_read_error_path = std::string::from_slice_in(
          zone,
          source_file.as_slice()
        );
      }
      read_error_count = read_error_count + collection_result.read_error_count;
    }
    let exit_code = cli_file_lint_exit_code(zone, diagnostic_count, read_error_count);
    var result_detail: Slice[u8] =
      "Source-file lint diagnostics were collected internally into a caller-provided vector without writing output.";
    if read_error_count > 0 {
      result_detail = first_read_error_path.as_slice();
    }
    var command_result = cli_command_result(
      CliSourceLintResult,
      false,
      diagnostic_count,
      read_error_count,
      exit_code,
      result_detail
    );
    if diagnostics.len() > 0 {
      command_result.first_diagnostic =
        super::diagnostic::some_diagnostic(diagnostics.get(0));
    }
    return command_result;
  }

  return dispatch_cli_command(zone, parse_result);
}

pub fn run_explicit_list_rules_command(zone: ref mut Zone) -> CliCommandResult {
  var tokens = std::vec::new<std::string::String>(zone, 1);
  tokens.push(std::string::from(zone, "--list-rules"));
  return run_explicit_cli_tokens(zone, tokens);
}

pub fn run_explicit_json_list_rules_command(zone: ref mut Zone) -> CliCommandResult {
  var tokens = std::vec::new<std::string::String>(zone, 2);
  tokens.push(std::string::from(zone, "--json"));
  tokens.push(std::string::from(zone, "--list-rules"));
  return run_explicit_cli_tokens(zone, tokens);
}

fn cli_tokens_from_os_argv(
  zone: ref mut Zone,
  argv: std::vec::Vec[std::string::String]
) -> std::vec::Vec[std::string::String] {
  var tokens = std::vec::new<std::string::String>(zone, argv.len());
  var index = 1;
  while index < argv.len() {
    tokens.push(argv.get(index));
    index = index + 1;
  }
  return tokens;
}

pub fn read_os_argv_tokens(zone: ref mut Zone) -> std::vec::Vec[std::string::String] {
  let argv = std::env::args(zone);
  return cli_tokens_from_os_argv(zone, argv);
}

pub fn run_os_argv_cli(zone: ref mut Zone) -> CliCommandResult {
  let tokens = read_os_argv_tokens(zone);
  let parse_result = parse_cli_tokens(zone, ref tokens);
  return dispatch_cli_command(zone, parse_result);
}

pub fn run_os_argv_cli_with_main_output(zone: ref mut Zone) -> CliCommandResult {
  let tokens = read_os_argv_tokens(zone);
  let parse_result = parse_cli_tokens(zone, ref tokens);
  return dispatch_cli_command_with_main_output(
    zone,
    ref tokens,
    parse_result
  );
}

// parse_cli_tokens consumes a caller-provided token list and records source
// counts, first source file path, retained source file paths, flags/options,
// explicit config path, parsed rule override values, first invalid rule
// override value, rule override problem count, missing option value details,
// unknown argument details, and parse problem counts in
// CliParseResult. It intentionally leaves environment handling, path
// validation, home/global/XDG config discovery, diagnostic printing, and
// ari --check invocation as future work.
//
// parse_cli_rule_overrides converts one raw --rule value into the internal
// config override count model and parse problem count. Source-file collection
// applies discovered or explicit config and --rule severity overrides. It
// searches from the current working directory upward for ari-lint.rules when
// --config is absent.
// compiler_check_plan_from_cli_args records a future ari --check invocation
// plan from already-parsed CLI args without invoking the compiler or
// tools/lint. plan_explicit_cli_compiler_check provides the same data-only plan
// for caller-provided tokens.
//
// dispatch_cli_command maps a CliParseResult to a stdout-free internal command
// result with internal exit-code data. For source-file arguments it reads each
// explicitly provided file path, runs in-memory lint aggregation, and carries
// the first internal diagnostic without writing output.
// collect_cli_source_diagnostics and collect_explicit_cli_diagnostics use the
// same explicit source-file boundary, but push full internal diagnostics into a
// caller-provided vector and apply discovered or explicit config overrides
// followed by parsed --rule severity overrides when provided. They do not
// write output, serialize JSON, search home/global/XDG config locations, scan
// source directories, call tools/lint, call process exit, or invoke ari
// --check.
// run_explicit_cli_tokens composes parsing and dispatch for callers that
// already have tokens. These entry paths do not write stdout/stderr, serialize
// JSON, recursively scan source trees, call tools/lint, call process exit, or
// invoke ari --check.
//
// CliExitCodeMapping records internal command-result-to-code decisions. It does
// not exit the process; main returns this code from the existing OS argv entry
// path.
//
// run_explicit_list_rules_command is the explicit-token command path for
// --list-rules. It reaches formatted text and exit-code data through the
// existing parser and dispatcher, but does not read OS argv, write stdout/stderr,
// or run a user-facing CLI process.
// run_explicit_json_list_rules_command is the matching explicit-token command
// path for --json --list-rules. It reaches the internal CliListRulesJson result
// through the same parser and dispatcher without writing stdout/stderr.
//
// read_os_argv_tokens is the verified OS argv boundary. It reads arguments
// through std::env::args, drops argv[0], and reuses the explicit-token parser
// and dispatcher through run_os_argv_cli. It does not read environment
// variables, write output, or call process exit. The main-facing wrapper adds
// only the scoped stdout/stderr writes described below.
//
// run_os_argv_cli_with_main_output is the main-facing output path. It writes
// human-readable list-rules text to stdout, or JSON list-rules text to stdout
// when --json is requested. It writes source-file lint diagnostics to stderr,
// or source-file JSON diagnostics to stdout when --json is requested, through
// verified output adapters. Source-file read errors and explicit config-file
// read errors write short stderr summaries without producing read-error JSON
// output. CLI help writes a concise stdout message, and CLI/config parse
// problems write a short summary to stderr. Missing source-file input also
// writes a short stderr summary. Home, global, and XDG config discovery,
// parse-error JSON, compiler invocation, ari --check, tools/lint, and process
// exit remain outside this path.
